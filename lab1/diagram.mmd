erDiagram
	USER ||--|| CART : owns
	USER ||--o{ ORDER : creates
	USER ||--o{ ADDRESS : has
	ADDRESS ||--o{ ORDER : delivers to
	USER ||--o{ SUPPORT_MESSAGE : writes
	MANAGER }o--o{ PRODUCT : updates
	PRODUCT }o--o{ CATEGORY : belongs_to
	CART ||--o{ CART_ITEM : contains
	PRODUCT ||--o{ CART_ITEM : appears_in
	ORDER ||--o{ ORDER_ITEM : contains
	PRODUCT ||--o{ ORDER_ITEM : ordered_as
	ORDER ||--o{ PAYMENT : has_attempts
	MANAGER o|--o{ SUPPORT_MESSAGE : handles

	USER {
		int user_id PK
		string name
		string password_hash
		string phone_number
		string email
	}

	ADDRESS {
		int address_id PK
		int user_id FK
		string city
		string street
		string building
		string post_code
	}

	MANAGER {
		int manager_id PK
		string name
		string password_hash
	}

	PRODUCT {
		int product_id PK
		string name
		string description
		decimal price
		int stock_amount
	}

	CATEGORY {
		int category_id PK
		string name
		string description
	}

	CART {
		int cart_id PK
		int user_id FK
		decimal total_price
	}

	CART_ITEM {
		int cart_id PK, FK
		int product_id PK, FK
		int quantity
	}

	ORDER {
		int order_id PK
		int user_id FK
		int address_id FK
		string number
		string status
		datetime order_time
	}

	ORDER_ITEM {
		int order_id PK, FK
		int product_id PK, FK
		int quantity
		decimal unit_price
	}

	PAYMENT {
		int payment_id PK
		int order_id FK
		decimal total_price
		string status
		datetime payment_time
	}

	SUPPORT_MESSAGE {
		int message_id PK
		int user_id FK
		int manager_id FK "nullable"
		string message_text
		datetime message_time
		string status
	}
